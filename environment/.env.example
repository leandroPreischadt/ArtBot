MODEL_NAME=\Users\airto\.lmstudio\models\lmstudio-community\gemma-3-4b-it-GGUF\gemma-3-4b-it-Q4_K_M.gguf
DEVICE=cuda
# No Jetson, use o nó PipeWire para acessar o DJI Mic Mini.
# O valor anterior/default da entrada ALSA aponta para a placa APE.
AUDIO_DEVICE=pipewire
TTS_MODEL_NAME=../MeusModelos/model.onnx
WAKE_WORD_MODEL=../MeusModelos/hey_jarvis_v0.1.tflite
N_CTX=1024
# Limite máximo de tokens gerados pela resposta do LLM.
MAX_TOKENS=3000
N_GPU_LAYERS=-1
N_BATCH=16
N_UBATCH=16
FLASH_ATTN=true
OFFLOAD_KQV=true
STT_MODEL_SIZE=base
STT_BEAM_SIZE=1
STT_LANGUAGE=pt
# Tempo máximo de uma captura após a wake word; evita gravações/RAM sem limite.
STT_MAX_RECORDING_SECONDS=30

# 0 = menos sensível a silêncio | 3 = mais sensível
VAD_AGGRESSIVENESS=3
# Frames de 30ms de voz para iniciar a gravação
START_FRAMES=2
# Frames de 30ms de silêncio contínuo para encerrar a gravação (40 = 1.2s)
END_SILENCE_FRAMES=40
# Confiança mínima para aceitar a wake word (0.0 a 1.0)
WAKEWORD_THRESHOLD=0.5

HTTP_PORT=8383
DATABASE_PATH=data/chroma
